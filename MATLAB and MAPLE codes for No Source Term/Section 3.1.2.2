% =========================================================
% Chapter 3 - Problem B (No Source Term, 1D)
% Evaluation at x = 0.55 on t = 0:0.05:1
%
% Problem B:
%   u_exact(x,t) = exp(t - x)
%   s_exact(t)   = t
%   h(t) = (2*t + sqrt(2*exp(t)*t^2 - 4*exp(t)*t + 2*t^2 + 4*t)) / (t*(-2+t))
%   u_HAM(x,t) = ((2 + (t^2 - 2*t)*h^2 - 4*h*t)*exp(-x))/2
%   s_HAM(t) = -log(2/(h^2*t^2 - 2*h^2*t - 4*h*t + 2))
%
% Table columns:
%   t, h(t), RelErr_u_at_x055, RelErr_s
% =========================================================

clc; clear; close all;

%% Settings
x_eval = 0.55;
t = (0:0.05:1)';

%% Writable output folder
userProfile = getenv('USERPROFILE');
if ~isempty(userProfile)
    outputDir = fullfile(userProfile, 'Documents', 'MATLAB', 'Chapter3_ProblemB');
else
    outputDir = fullfile(pwd, 'Chapter3_ProblemB');
end
if ~exist(outputDir, 'dir')
    mkdir(outputDir);
end

%% Compute h(t)
h = zeros(size(t));
for j = 1:numel(t)
    tj = t(j);
    if abs(tj) < 1e-12
        h(j) = -1;  % removable singularity value at t=0
    else
        rad = 2*exp(tj)*tj^2 - 4*exp(tj)*tj + 2*tj^2 + 4*tj;
        if rad < 0 && abs(rad) < 1e-12
            rad = 0;
        end
        h(j) = (2*tj + sqrt(rad)) / (tj*(-2 + tj));
    end
end

%% Exact and HAM interface
s_exact = t;
den_s = (h.^2).*(t.^2) - 2*(h.^2).*t - 4*h.*t + 2;
s_ham = -log(2 ./ den_s);
s_ham = real(s_ham);

RelErr_s = abs(s_exact - s_ham) ./ max(abs(s_exact), eps);

%% Exact and HAM solution at x = 0.55
u_exact = exp(t - x_eval);
u_ham   = ((2 + (t.^2 - 2*t).*(h.^2) - 4*h.*t) * exp(-x_eval)) / 2;
u_ham   = real(u_ham);

RelErr_u = abs(u_exact - u_ham) ./ max(abs(u_exact), eps);

%% Output table
T = table(t, h, RelErr_u, RelErr_s, ...
    'VariableNames', {'t', 'h_t', 'RelErr_u_at_x055', 'RelErr_s'});

disp(' ');
disp('Chapter 3 Problem B: t, h(t), RelErr_u(x=0.55,t), RelErr_s(t)');
disp(T);

%% Save CSV
csvFile = fullfile(outputDir, 'ProblemB_t_h_RelErrU_RelErrS_x055.csv');
try
    writetable(T, csvFile);
    fprintf('\nCSV saved to:\n%s\n', csvFile);
catch ME
    warning('Primary CSV save failed: %s', ME.message);
    fallbackFile = fullfile(tempdir, ...
        ['ProblemB_t_h_RelErrU_RelErrS_x055_' datestr(now,'yyyymmdd_HHMMSS') '.csv']);
    writetable(T, fallbackFile);
    fprintf('CSV saved to temp folder instead:\n%s\n', fallbackFile);
end

%% Plot 1: u(0.55,t) vs u_HAM(0.55,t)
fig1 = figure;
plot(t, u_exact, '-o', 'LineWidth', 1.2, 'MarkerSize', 5); hold on;
plot(t, u_ham,   '--s', 'LineWidth', 1.2, 'MarkerSize', 5);
grid on;
xlabel('t');
ylabel('u(0.55,t)');
title('Problem B: u(0.55,t) vs u_{HAM}(0.55,t)');
legend('u(0.55,t) exact', 'u_{HAM}(0.55,t)', 'Location', 'best');

%% Plot 2: s(t) vs s_HAM(t)
fig2 = figure;
plot(t, s_exact, '-o', 'LineWidth', 1.2, 'MarkerSize', 5); hold on;
plot(t, s_ham,   '--s', 'LineWidth', 1.2, 'MarkerSize', 5);
grid on;
xlabel('t');
ylabel('s(t)');
title('Problem B: s(t) vs s_{HAM}(t)');
legend('s(t) exact', 's_{HAM}(t)', 'Location', 'best');

%% Save plots
try
    exportgraphics(fig1, fullfile(outputDir, 'ProblemB_u055_vs_uHAM.png'), 'Resolution', 300);
    exportgraphics(fig1, fullfile(outputDir, 'ProblemB_u055_vs_uHAM.pdf'), 'ContentType', 'vector');
    exportgraphics(fig2, fullfile(outputDir, 'ProblemB_s_vs_sHAM.png'), 'Resolution', 300);
    exportgraphics(fig2, fullfile(outputDir, 'ProblemB_s_vs_sHAM.pdf'), 'ContentType', 'vector');
    fprintf('\nPlots saved in:\n%s\n', outputDir);
catch ME
    warning('Plot export warning: %s', ME.message);
end
